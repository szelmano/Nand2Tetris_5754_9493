class Umbrella {

    function void draw(int location) {
        do Umbrella.drawByState(location, 0, 0);
        return;
    }

    function void clear(int location) {
        do Umbrella.clearByState(location, 0, 0);
        return;
    }

    function void drawSmallRow(int memAddress, int rowOffset, int value) {
        do Memory.poke(memAddress + rowOffset, value);
        return;
    }

    function void drawMediumRow(int memAddress, int rowOffset, int word1, int word2) {
        do Memory.poke(memAddress + rowOffset, word1);
        do Memory.poke(memAddress + rowOffset + 1, word2);
        do Memory.poke(memAddress + rowOffset + 32, word1);
        do Memory.poke(memAddress + rowOffset + 33, word2);
        return;
    }

    function void drawHugeRow(int memAddress, int rowOffset, int word1, int word2, int word3) {
        do Memory.poke(memAddress + rowOffset, word1);
        do Memory.poke(memAddress + rowOffset + 1, word2);
        do Memory.poke(memAddress + rowOffset + 2, word3);

        do Memory.poke(memAddress + rowOffset + 32, word1);
        do Memory.poke(memAddress + rowOffset + 33, word2);
        do Memory.poke(memAddress + rowOffset + 34, word3);

        do Memory.poke(memAddress + rowOffset + 64, word1);
        do Memory.poke(memAddress + rowOffset + 65, word2);
        do Memory.poke(memAddress + rowOffset + 66, word3);
        return;
    }

    function void clearSmallArea(int location) {
        var int memAddress;
        let memAddress = 16384 + location;

        do Memory.poke(memAddress + 0, 0);
        do Memory.poke(memAddress + 32, 0);
        do Memory.poke(memAddress + 64, 0);
        do Memory.poke(memAddress + 96, 0);
        do Memory.poke(memAddress + 128, 0);
        do Memory.poke(memAddress + 160, 0);
        do Memory.poke(memAddress + 192, 0);
        do Memory.poke(memAddress + 224, 0);
        do Memory.poke(memAddress + 256, 0);
        do Memory.poke(memAddress + 288, 0);
        do Memory.poke(memAddress + 320, 0);
        do Memory.poke(memAddress + 352, 0);
        do Memory.poke(memAddress + 384, 0);
        do Memory.poke(memAddress + 416, 0);
        do Memory.poke(memAddress + 448, 0);
        do Memory.poke(memAddress + 480, 0);
        return;
    }

    function void clearMediumRow(int memAddress, int rowOffset) {
        do Memory.poke(memAddress + rowOffset, 0);
        do Memory.poke(memAddress + rowOffset + 1, 0);
        do Memory.poke(memAddress + rowOffset + 32, 0);
        do Memory.poke(memAddress + rowOffset + 33, 0);
        return;
    }

    function void clearMediumArea(int location) {
        var int memAddress;
        let memAddress = 16384 + location;

        do Umbrella.clearMediumRow(memAddress, 0);
        do Umbrella.clearMediumRow(memAddress, 64);
        do Umbrella.clearMediumRow(memAddress, 128);
        do Umbrella.clearMediumRow(memAddress, 192);
        do Umbrella.clearMediumRow(memAddress, 256);
        do Umbrella.clearMediumRow(memAddress, 320);
        do Umbrella.clearMediumRow(memAddress, 384);
        do Umbrella.clearMediumRow(memAddress, 448);
        do Umbrella.clearMediumRow(memAddress, 512);
        do Umbrella.clearMediumRow(memAddress, 576);
        do Umbrella.clearMediumRow(memAddress, 640);
        do Umbrella.clearMediumRow(memAddress, 704);
        do Umbrella.clearMediumRow(memAddress, 768);
        do Umbrella.clearMediumRow(memAddress, 832);
        do Umbrella.clearMediumRow(memAddress, 896);
        do Umbrella.clearMediumRow(memAddress, 960);
        return;
    }

    function void clearHugeRow(int memAddress, int rowOffset) {
        do Memory.poke(memAddress + rowOffset, 0);
        do Memory.poke(memAddress + rowOffset + 1, 0);
        do Memory.poke(memAddress + rowOffset + 2, 0);

        do Memory.poke(memAddress + rowOffset + 32, 0);
        do Memory.poke(memAddress + rowOffset + 33, 0);
        do Memory.poke(memAddress + rowOffset + 34, 0);

        do Memory.poke(memAddress + rowOffset + 64, 0);
        do Memory.poke(memAddress + rowOffset + 65, 0);
        do Memory.poke(memAddress + rowOffset + 66, 0);
        return;
    }

    function void clearHugeArea(int location) {
        var int memAddress;
        let memAddress = 16384 + location;

        do Umbrella.clearHugeRow(memAddress, 0);
        do Umbrella.clearHugeRow(memAddress, 96);
        do Umbrella.clearHugeRow(memAddress, 192);
        do Umbrella.clearHugeRow(memAddress, 288);
        do Umbrella.clearHugeRow(memAddress, 384);
        do Umbrella.clearHugeRow(memAddress, 480);
        do Umbrella.clearHugeRow(memAddress, 576);
        do Umbrella.clearHugeRow(memAddress, 672);
        do Umbrella.clearHugeRow(memAddress, 768);
        do Umbrella.clearHugeRow(memAddress, 864);
        do Umbrella.clearHugeRow(memAddress, 960);
        do Umbrella.clearHugeRow(memAddress, 1056);
        do Umbrella.clearHugeRow(memAddress, 1152);
        do Umbrella.clearHugeRow(memAddress, 1248);
        do Umbrella.clearHugeRow(memAddress, 1344);
        do Umbrella.clearHugeRow(memAddress, 1440);
        return;
    }

    function void clearByState(int location, int rotation, int sizeMode) {
        if (sizeMode = 2) {
            do Umbrella.clearSmallArea(location);
        }
        if (sizeMode = 0) {
            do Umbrella.clearMediumArea(location);
        }
        if (sizeMode = 1) {
            do Umbrella.clearHugeArea(location);
        }
        return;
    }

    function void drawByState(int location, int rotation, int sizeMode) {
        if (sizeMode = 2) {
            if (rotation = 0) { do Umbrella.drawSmall0(location); }
            if (rotation = 90) { do Umbrella.drawSmall90(location); }
            if (rotation = 180) { do Umbrella.drawSmall180(location); }
            if (rotation = 270) { do Umbrella.drawSmall270(location); }
        }

        if (sizeMode = 0) {
            if (rotation = 0) { do Umbrella.drawMedium0(location); }
            if (rotation = 90) { do Umbrella.drawMedium90(location); }
            if (rotation = 180) { do Umbrella.drawMedium180(location); }
            if (rotation = 270) { do Umbrella.drawMedium270(location); }
        }

        if (sizeMode = 1) {
            if (rotation = 0) { do Umbrella.drawHuge0(location); }
            if (rotation = 90) { do Umbrella.drawHuge90(location); }
            if (rotation = 180) { do Umbrella.drawHuge180(location); }
            if (rotation = 270) { do Umbrella.drawHuge270(location); }
        }
        return;
    }

    function void drawSmall0(int location) {
        var int memAddress;
        let memAddress = 16384 + location;

        do Umbrella.drawSmallRow(memAddress, 0, 0);
        do Umbrella.drawSmallRow(memAddress, 32, 768);
